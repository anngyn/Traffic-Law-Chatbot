# AWS Bedrock RAG Chatbot Environment Configuration Template
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Configuration
S3_BUCKET_NAME=rag-traffic-vi
S3_RAW_PREFIX=raw/
S3_INDEX_PREFIX=index/
S3_LOGS_PREFIX=logs/

# Bedrock Configuration
BEDROCK_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
LLM_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
CHROMA_COLLECTION=AI002

# Local Embedding Fallback
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Vector Search Configuration
FAISS_INDEX_TYPE=IVF1024,Flat
EMBEDDING_DIMENSION=1024
NLIST=1024
TOP_K_RESULTS=5
CONFIDENCE_THRESHOLD=0.7

# Text Processing Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_TOKENS=8000

# Lambda Configuration
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_RAG=1024
LAMBDA_MEMORY_INDEXER=512
LAMBDA_MEMORY_HEALTH=128

# API Configuration
API_URL=http://localhost:8000
API_GATEWAY_STAGE=prod

# Auth & Rate limiting (auth disabled if API_KEYS empty)
API_KEYS=
RATE_LIMIT=30/minute

# Memory: cache (Redis, optional) + chat history (SQLAlchemy)
REDIS_URL=
DATABASE_URL=sqlite:///data/chat_history.db

# Observability: LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai002-traffic-rag

# Retrieval pipeline
ENABLE_HYBRID=true
ENABLE_RERANK=false
RERANK_TOP_N=4
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
CORS_ORIGINS=*

# Monitoring Configuration
LOG_LEVEL=INFO
ENABLE_METRICS=true
ENABLE_TRACING=false

# Free Tier Limits (for monitoring)
MAX_S3_STORAGE_GB=5
MAX_LAMBDA_REQUESTS_MONTHLY=1000000
MAX_API_REQUESTS_MONTHLY=1000000
MAX_CLOUDWATCH_LOGS_GB=5

# Vietnamese Text Processing
VIETNAMESE_STOPWORDS_FILE=data/vietnamese-stopwords-dash.txt
ENABLE_VIETNAMESE_SEGMENTATION=true

# Security Configuration
ENABLE_GUARDRAILS=true
MASK_PII_IN_LOGS=true
MAX_QUERY_LENGTH=1000